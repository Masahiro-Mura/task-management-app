            "value": "Diese Datei stammt aus einer neueren TaskFlow-Version. Bitte aktualisiere die App vor dem Import."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was exported from a newer version of TaskFlow. Please update the app before importing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo se exportó desde una versión más reciente de TaskFlow. Actualiza la app antes de importarlo."
          }
        },
        "fr": {
