            "value": "¿Sin ganas? ¿Pasamos a tareas ligeras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas motivé ? Passer aux tâches légères ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ne hai voglia? Passare alle attività leggere?"
