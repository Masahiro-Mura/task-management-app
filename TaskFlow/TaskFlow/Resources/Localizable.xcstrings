    "候補は端末内のAIで作りました。データは端末の外に出ません。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschläge stammen von der KI auf dem Gerät. Deine Daten verlassen das Gerät nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions were made by the on-device AI. Your data never leaves the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias las creó la IA del dispositivo. Tus datos no salen del dispositivo."
