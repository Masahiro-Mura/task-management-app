    "集中画面で終えたタスクの、実際にかかった時間と見積もりの比べです。1行追加で時間を書かなかったときの初期値（いまは%lld分）に使っています。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht die tatsächliche Zeit mit der Schätzung bei Aufgaben, die im Fokus-Bildschirm erledigt wurden. Dient als Standard (jetzt %lld Min.), wenn du in der Eingabezeile keine Zeit angibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares the actual time with the estimate for tasks finished on the focus screen. Used as the default (now %lld min) when you don’t write a time in the one-line input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara el tiempo real con lo estimado en las tareas terminadas en la pantalla de concentración. Se usa como valor por defecto (ahora %lld min) cuando no escribes un tiempo en la entrada de una línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare le temps réel et l’estimation des tâches terminées sur l’écran de concentration. Sert de valeur par défaut (actuellement %lld min) quand vous n’indiquez pas de durée dans la saisie en une ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta il tempo reale con la stima per le attività completate nella schermata di concentrazione. Serve come valore predefinito (ora %lld min) quando non scrivi un tempo nell’inserimento a una riga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 화면에서 끝낸 작업의 실제 걸린 시간과 예상을 비교해요. 한 줄 입력에 시간을 쓰지 않았을 때의 기본값(지금은 %lld분)으로 써요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara o tempo real com a estimativa das tarefas concluídas na tela de foco. É usado como padrão (agora %lld min) quando você não escreve um tempo na entrada de uma linha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较在专注页面完成的任务的实际用时与预估。单行输入未写时间时作为默认值（现在为%lld分钟）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較在專注畫面完成的任務的實際用時與預估。單行輸入沒寫時間時當作預設值（目前為%lld分鐘）。"
          }
        }
      }
    },
