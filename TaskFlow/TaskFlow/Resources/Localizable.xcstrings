    "気が乗らないときは、軽いものにしますか？": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Lust? Auf leichte Aufgaben wechseln?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not feeling it? Switch to light tasks?"
          }
        },
