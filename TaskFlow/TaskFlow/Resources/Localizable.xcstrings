    "日付は変えずに、今日のおすすめで優先します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält das Datum und bevorzugt sie bei den heutigen Vorschlägen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the date and prioritizes it in today’s picks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la fecha y la prioriza en las sugerencias de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la date et la met en priorité aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la data e le dà priorità nei suggerimenti di oggi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜는 그대로 두고 오늘 추천에서 우선해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a data e dá prioridade nas sugestões de hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不改日期，在今天的推荐中优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不改日期，在今天的推薦中優先。"
          }
        }
      }
    },
