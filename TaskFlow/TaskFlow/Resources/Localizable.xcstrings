    "%lld分、手をつけられました。続けますか？": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld Min. angefangen. Weitermachen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You got started for %lld min. Keep going?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dedicaste %lld min. ¿Sigues?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous y êtes mis pendant %lld min. On continue ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci hai lavorato %lld min. Continui?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분 동안 손을 댔어요. 계속할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você começou por %lld min. Quer continuar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经动手%lld分钟了。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經動手%lld分鐘了。要繼續嗎？"
          }
        }
      }
    },
    "%lld分たったら、続けるかどうか選べます": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %lld Min. kannst du entscheiden, ob du weitermachst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After %lld min, you can choose whether to keep going"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de %lld min podrás elegir si sigues"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après %lld min, vous pourrez choisir de continuer ou non"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo %lld min potrai scegliere se continuare"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분이 지나면 계속할지 고를 수 있어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de %lld min, você pode escolher se continua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分钟后，可以选择是否继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分鐘後，可以選擇是否繼續"
          }
        }
      }
    },
