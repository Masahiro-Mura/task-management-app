          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 시간・마감・우선순위를 보고 지금 할 작업을 하나만 골라요. 왜 그 작업인지 이유도 알려 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma única tarefa para agora a partir do seu tempo livre, prazos e prioridades — e diz por quê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
