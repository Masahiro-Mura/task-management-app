    "日付・時間・くり返しは、書いたとおりに読み取ります。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum, Uhrzeit und Wiederholung werden so gelesen, wie du sie schreibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates, times, and repeats are read just as you write them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas, horas y repeticiones se leen tal como las escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates, heures et répétitions sont lues telles que vous les écrivez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Date, orari e ripetizioni vengono letti così come li scrivi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜・시간・반복은 쓴 그대로 읽어 들여요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Datas, horários e repetições são lidos do jeito que você escreve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、时间和重复会按你写的内容识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、時間和重複會照你寫的內容判讀。"
          }
        }
      }
    },
    "日時": {
