    "選んだタスクが終わるまで、このタスクはおすすめに出ません。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe wird erst vorgeschlagen, wenn die ausgewählten erledigt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task won’t be recommended until the selected tasks are done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea no se sugerirá hasta que terminen las tareas elegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche ne sera pas suggérée tant que les tâches choisies ne sont pas terminées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa attività non verrà suggerita finché quelle scelte non sono finite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 작업이 끝날 때까지 이 작업은 추천에 나오지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
