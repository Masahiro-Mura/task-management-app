    "タスクの編集画面で「頭を使わない軽い作業」にしておくと、こういうときに出てきます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere eine Aufgabe beim Bearbeiten als „Leichte Aufgabe, ohne Denkarbeit“, dann erscheint sie in solchen Momenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark a task as “Light task, no brainpower” on its edit screen and it will show up at times like this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una tarea como “Tarea ligera, sin pensar” al editarla y aparecerá en momentos así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez une tâche comme « Tâche légère, sans effort mental » dans sa modification et elle apparaîtra dans ces moments-là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna un’attività come “Attività leggera, senza concentrazione” nella modifica e comparirà in momenti come questo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 편집 화면에서 ‘머리를 쓰지 않는 가벼운 작업’으로 해 두면 이럴 때 나와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma tarefa como “Tarefa leve, sem pensar” ao editá-la e ela vai aparecer em momentos assim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任务编辑页设为“不用动脑的轻松任务”，这种时候就会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任務編輯頁設為「不用動腦的輕鬆任務」，這種時候就會出現。"
          }
        }
      }
    },
