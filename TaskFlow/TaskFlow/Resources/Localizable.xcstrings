    "reason.leadAndFit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, und ihre %2$lld Min. passen in deine %3$lld freien Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, and its %2$lld min fit in your %3$lld free minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, y sus %2$lld min caben en tus %3$lld min libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, et ses %2$lld min tiennent dans vos %3$lld min libres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, e i suoi %2$lld min stanno nei tuoi %3$lld min liberi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 걸리는 시간 %2$lld분이 빈 시간 %3$lld분에 들어가기 때문이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, e os %2$lld min dela cabem nos seus %3$lld min livres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，而且所需%2$lld分钟能放进空闲的%3$lld分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，而且所需%2$lld分鐘能放進空閒的%3$lld分鐘。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、所要時間%lld分が空き時間%lld分に収まるからです。"
          }
        }
      }
    },
    "reason.overdue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frist ist vorbei, aber ihre %lld Min. passen in deine %lld freien Minuten – du kannst sie jetzt erledigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deadline has passed, but its %lld min fit in your %lld free minutes, so you can get it done now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha límite ya pasó, pero sus %lld min caben en tus %lld min libres, así que puedes terminarla ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échéance est passée, mais ses %lld min tiennent dans vos %lld min libres : vous pouvez la terminer maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scadenza è passata, ma i suoi %lld min stanno nei tuoi %lld min liberi: puoi completarla ora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감은 지났지만 걸리는 시간 %lld분이 빈 시간 %lld분에 들어가니, 지금이라면 끝낼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prazo já passou, mas os %lld min dela cabem nos seus %lld min livres, então dá para terminar agora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虽然已过截止时间，但所需%lld分钟能放进空闲的%lld分钟，现在就能完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雖然已過截止時間，但所需%lld分鐘能放進空閒的%lld分鐘，現在就能完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限は過ぎていますが、所要時間%lld分が空き時間%lld分に収まるので、今なら片づけられます。"
          }
        }
      }
