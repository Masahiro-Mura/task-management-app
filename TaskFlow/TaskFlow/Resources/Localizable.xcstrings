    "予定どおりにいかないのは、よくあることです。まとめて置き直しましょう。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dass es nicht nach Plan läuft, ist normal. Lass sie uns gemeinsam neu einplanen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things not going as planned is normal. Let’s reschedule them together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que las cosas no salgan según lo previsto es normal. Reorganicémoslas juntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que les choses ne se passent pas comme prévu, c’est normal. Replanifions-les ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È normale che le cose non vadano come previsto. Ripianifichiamole insieme."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획대로 안 되는 건 흔한 일이에요. 한꺼번에 다시 정해 봐요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É normal as coisas não saírem como planejado. Vamos reorganizar juntas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划赶不上变化是常有的事。一起重新安排吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫趕不上變化是常有的事。一起重新安排吧。"
          }
        }
      }
    },
